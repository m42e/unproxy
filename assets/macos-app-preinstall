#!/bin/sh
set -eu
console_user=$(/usr/bin/stat -f %Su /dev/console)
if [ "$console_user" != root ] && [ "$console_user" != loginwindow ] && [ -n "$console_user" ]; then
    uid=$(/usr/bin/id -u "$console_user")
    for label in de.m42e.unproxy com.github.m42e.unproxy; do
        if /bin/launchctl print "gui/$uid/$label" >/dev/null 2>&1; then
            /bin/launchctl bootout "gui/$uid/$label"
        fi
    done
fi
# The menu-bar app owns its proxy; old socket-activated agents would compete for its listeners.
rm -f /Library/LaunchAgents/de.m42e.unproxy.plist
rm -f /Library/LaunchAgents/com.github.m42e.unproxy.plist
